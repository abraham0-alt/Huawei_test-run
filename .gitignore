# Re-include small files that belong in git
!reports/**
!reports/**/*.csv
!reports/**/*.parquet
!reports/**/*.pkl
!reports/**/*.pickle
!reports/**/*.joblib
!reports/**/*.lgb
!reports/**/*.cbm
!reports/**/*.npy
!reports/**/*.npz
